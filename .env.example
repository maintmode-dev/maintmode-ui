# Backend resource server (maintmode service: /api/v1/maintenances/**, /ui/v1/calendar, /api/v1/resources)
MAINTMODE_API_BASE_URL=http://localhost:9000/maintmode
MAINTMODE_API_TIMEOUT_MS=10000

# Auth service (separate Go service: /api/v1/login/oauth/exchange/google,
# /refresh, /logout, /me). When auth and maintmode run as a single binary,
# leave this empty and the frontend will fall back to MAINTMODE_API_BASE_URL.
MAINTMODE_AUTH_API_BASE_URL=http://localhost:9000/auth

# Frontend auth shell (NextAuth v5)
# Generate with: openssl rand -hex 32
MAINTMODE_AUTH_SECRET=replace-with-32-char-random-secret
MAINTMODE_APP_BASE_URL=http://localhost:3000

# Google OAuth (BFF-owned). The same client_id must be configured on the
# auth-service as `oauth/google/client_id` so it can verify the Google ID
# token's `aud` during exchange.
#
# Authorized redirect URIs to add in Google Cloud Console:
#   - ${MAINTMODE_APP_BASE_URL}/api/auth/callback/google
MAINTMODE_GOOGLE_OAUTH_CLIENT_ID=
MAINTMODE_GOOGLE_OAUTH_CLIENT_SECRET=

# Local-only: skip the auth middleware so the UI is browsable without an
# OAuth round-trip. Off by default. NEVER set in production.
# MAINTMODE_DISABLE_AUTH_GUARD=1

# Local-only: enables a "Continue as dev user" button on /login that runs
# the NextAuth flow with a placeholder id_token. Backend must accept dev
# id_tokens for this to work. Ignored when NODE_ENV=production.
# MAINTMODE_DEV_AUTH_BYPASS=true
