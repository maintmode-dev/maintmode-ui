{
  "name": "maintmode-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "dev": "next dev -p 3000",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run -c vitest.unit.config.ts --coverage",
    "test:boundaries": "node scripts/check-boundaries.mjs",
    "test:contracts": "vitest run -c vitest.contracts.config.ts",
    "test:bundle": "node scripts/check-bundle-budget.mjs",
    "fixtures:refresh": "node scripts/refresh-fixtures.mjs",
    "fixtures:audit-actions": "node scripts/sync-audit-actions.mjs",
    "verify": "npm run lint && npm run typecheck && npm run format && npm run test:boundaries && npm run test:contracts && npm run test:unit && npm run build && npm run test:bundle"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/luxon3": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@tanstack/react-query": "^5.105.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "luxon": "^3.7.2",
    "next": "^16.4.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
