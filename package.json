{
  "name": "maintmode-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "dev": "next dev -p 3000",
    "build": "next build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "npm run test:unit && npm run test:bff",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:bff": "vitest run -c vitest.bff.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run -c vitest.unit.config.ts --coverage && vitest run -c vitest.bff.config.ts --coverage",
    "test:contracts": "node scripts/check-boundaries.mjs",
    "test:smoke": "playwright test -c tests/playwright.config.ts --ignore-snapshots --grep-invert @a11y",
    "test:smoke:headed": "playwright test -c tests/playwright.config.ts --headed --grep-invert @a11y",
    "test:a11y": "playwright test -c tests/playwright.config.ts --grep @a11y",
    "verify": "npm run lint && npm run test:contracts && npm run test:unit && npm run test:bff && npm run build"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.87.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "next": "^16.1.1",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.75.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.53.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.1",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.18"
  }
}
