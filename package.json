{
  "name": "maintmode-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "dev": "next dev -p 3000",
    "build": "next build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "node scripts/check-boundaries.mjs",
    "test:smoke": "playwright test -c tests/playwright.config.ts",
    "verify": "npm run lint && npm run test:contracts && npm run test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.87.1",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.53.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.1",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.18"
  }
}
