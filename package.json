{
  "name": "maintmode-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "dev": "next dev -p 3000",
    "build": "next build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run -c vitest.unit.config.ts --coverage",
    "test:contracts": "node scripts/check-boundaries.mjs",
    "verify": "npm run lint && npm run format && npm run test:contracts && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.87.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.16.0",
    "next": "^16.1.1",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.76.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.18"
  }
}
