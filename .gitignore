.DS_Store
node_modules

.next/

dev.log

/screenshots/

# Playwright MCP staging output (console logs, snapshots, screenshots).
.playwright-mcp/

.tmp/

.env
.env.local
.env.*.local

# Per-environment runtime config holding real values / secrets. Only the
# *.example files are committed (see deployment/<env>/app.env.example).
deployment/*/app.env

tsconfig.tsbuildinfo
.claude/skills
smoke-run/

*.har

# DevTools performance traces — multi-MB, captured ad hoc for perf work.
# Keep the numbers in docs/perf/, not the raw dump.
Trace-*.json.gz

SPEC*.md

.agents/tasks/

tasks/

# Scratch state and archived specs/plans from the /flow skill. Working
# artifacts of a single task, not repository content.
.flow/
# `docs/` is ignored, EXCEPT the contract-gap registry — an executable artifact
# whose rows a test asserts against the captured wire fixtures (RUK-254,
# SPEC §4.4). Written as three rules because git cannot re-include a file inside
# an excluded directory: the directory has to stay traversable (`docs/*`, not
# `docs/`) for the negation to be reachable at all.
docs/*
!docs/contract-gaps.md