# maintmode-ui — production environment
#
# Production secrets MUST NOT live in git. This .example documents the required
# variables only. Inject the real values through your secrets manager / CD
# pipeline (e.g. mounted --env-file produced at deploy time, k8s Secret, etc.).
#
# There is intentionally no `make up env=prod`: production is deployed by the
# orchestrator, not the local Makefile.

# --- Backend (BFF target) ---------------------------------------------------
MAINTMODE_API_BASE_URL=https://maintmode.example/maintmode
MAINTMODE_AUTH_API_BASE_URL=https://maintmode.example/auth
MAINTMODE_API_TIMEOUT_MS=10000
MAINTMODE_ENABLE_MOCK_DATA=false

# --- Frontend auth shell (NextAuth v5) --------------------------------------
# Min 32 chars. Generate with: openssl rand -hex 32
MAINTMODE_AUTH_SECRET=
MAINTMODE_APP_BASE_URL=https://maintmode.example

# Google OAuth — same client_id the backend verifies aud against.
# Authorized redirect URI in Google Cloud Console:
#   ${MAINTMODE_APP_BASE_URL}/api/auth/callback/google
MAINTMODE_GOOGLE_OAUTH_CLIENT_ID=
MAINTMODE_GOOGLE_OAUTH_CLIENT_SECRET=

# NEVER set MAINTMODE_DEV_AUTH_BYPASS or MAINTMODE_DISABLE_AUTH_GUARD in prod.
