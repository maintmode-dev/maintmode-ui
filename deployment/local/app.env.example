# maintmode-ui — local environment
#
# Copy to app.env (gitignored) and fill in real values:
#   cp deployment/local/app.env.example deployment/local/app.env
# Then run:  make up env=local
#
# "local" targets a backend running on the host. From inside the container,
# localhost is the container itself — use host.docker.internal so the BFF can
# reach the backend listening on the host's :9000.

# --- Backend (BFF target) ---------------------------------------------------
MAINTMODE_API_BASE_URL=http://host.docker.internal:9000/maintmode
MAINTMODE_AUTH_API_BASE_URL=http://host.docker.internal:9000/auth
MAINTMODE_API_TIMEOUT_MS=10000
MAINTMODE_ENABLE_MOCK_DATA=false

# --- Frontend auth shell (NextAuth v5) --------------------------------------
# Min 32 chars. Generate with: openssl rand -hex 32
MAINTMODE_AUTH_SECRET=local-dev-secret-please-rotate-me-32chars
MAINTMODE_APP_BASE_URL=http://localhost:3000

# Google OAuth — same client_id the backend verifies aud against.
MAINTMODE_GOOGLE_OAUTH_CLIENT_ID=
MAINTMODE_GOOGLE_OAUTH_CLIENT_SECRET=

# Local-only: "Continue as dev user" button on /login. Ignored when
# NODE_ENV=production, so it only takes effect if you run a non-prod build.
MAINTMODE_DEV_AUTH_BYPASS=true
