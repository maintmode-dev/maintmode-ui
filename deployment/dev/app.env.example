# maintmode-ui — dev environment
#
# Copy to app.env (gitignored) and fill in real values:
#   cp deployment/dev/app.env.example deployment/dev/app.env
# Then run:  make up env=dev
#
# The dev container joins the backend docker network (theapp, see Makefile
# NETWORK) and reaches the caddy gateway by its service DNS name. caddy listens
# on :3000 inside the network (published as :9000 on the host) and proxies the
# /auth and /maintmode path prefixes to the backend services.

# --- Backend (BFF target) ---------------------------------------------------
MAINTMODE_API_BASE_URL=http://caddy:3000/maintmode
MAINTMODE_AUTH_API_BASE_URL=http://caddy:3000/auth
MAINTMODE_API_TIMEOUT_MS=10000
MAINTMODE_ENABLE_MOCK_DATA=false

# --- Frontend auth shell (NextAuth v5) --------------------------------------
# Min 32 chars. Generate with: openssl rand -hex 32
MAINTMODE_AUTH_SECRET=
# The browser-facing origin. The container publishes :3000 on the host, so the
# app is reached at http://localhost:3000.
MAINTMODE_APP_BASE_URL=http://localhost:3000

# Public origin of the auth backend, as the BROWSER reaches it, including any
# gateway path prefix. The provider button on /login redirects the browser here
# to start the backend-driven OAuth dance (RUK-292).
#
# NOT the same as MAINTMODE_AUTH_API_BASE_URL above: that one is used
# server-to-server and may be a container name the browser cannot resolve —
# reusing it here ships a button that dies in the user's browser.
MAINTMODE_AUTH_PUBLIC_BASE_URL=http://localhost:9000/auth
